{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynamis.local/schemas/entity.schema.json",
  "title": "DYNAMIS Entity (org-as-contract)",
  "description": "Law 20: a business entity exists in the network only with a charter, a DoA matrix, budget envelopes, a KPI tree, and a named human regulator. Missing any one = sandbox toy, not an entity. Canonical instance for Gate 0.5: params/entities/ent-001.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity"],
  "properties": {
    "entity": { "$ref": "#/$defs/entity" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "muc": { "type": "integer", "minimum": 0 },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "charter", "doa", "budgets", "kpi_tree", "regulator", "crew", "ledger", "keys"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["internal-office", "llc", "dao-llc"],
          "description": "The first entity is an internal-office; conversion to an LLC is a Phase-1 counsel package (docs/02 §7)." },
        "charter": {
          "type": "object", "additionalProperties": false,
          "required": ["purpose", "prohibited"],
          "properties": {
            "purpose": { "type": "string", "minLength": 10 },
            "term": { "type": "string" },
            "prohibited": { "type": "array", "items": { "type": "string" },
              "description": "Class-X acts restated per entity — never empty (Law 20)." }
          }
        },
        "doa": { "$ref": "#/$defs/id", "description": "DoA matrix file id (doa.schema.json)." },
        "budgets": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object", "additionalProperties": false,
            "required": ["cap_usds_muc", "period"],
            "properties": {
              "cap_usds_muc": { "$ref": "#/$defs/muc" },
              "period": { "enum": ["weekly", "monthly"] }
            }
          }
        },
        "kpi_tree": { "$ref": "#/$defs/id" },
        "regulator": { "type": "string", "minLength": 3,
          "description": "The named human veto holder (e.g. owner-via-scribe). Never an agent (docs/02 §6)." },
        "crew": { "type": "array", "minItems": 1,
          "description": "Department role ids bound to job-market subscriptions.",
          "items": { "type": "string" } },
        "ledger": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*\\.jsonl$",
          "description": "The entity's own append-only book at the root. Books never leave the root (Law 16)." },
        "keys": {
          "type": "object", "additionalProperties": false,
          "required": ["signing", "rail"],
          "properties": {
            "signing": { "type": "string", "pattern": "^hsm:.+$",
              "description": "HSM keyref, census-fresh, two-soul (Laws 1–3)." },
            "rail": { "type": "string",
              "description": "Persona-scoped rail key reference; personas never claim the root (Law 17)." }
          }
        }
      }
    }
  }
}
